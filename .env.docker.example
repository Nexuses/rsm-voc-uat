# Optional helpers when using Docker Postgres from a host-run Next.js app.
# Copy values into `.env.local` (do not commit real secrets).

# Host app → Docker Postgres (published on localhost:5432)
DATABASE_URL="postgresql://rsm_voc:rsm_voc@localhost:5432/rsm_voc?schema=public"

OPENAI_API_KEY="sk-..."
ELEVENLABS_WEBHOOK_SECRET="whsec_..."
ELEVENLABS_API_KEY="..."
ELEVENLABS_AGENT_ID="agent_..."

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
SURVEY_PUBLIC_URL="http://localhost:3000"

FROM_EMAIL="rsm-kuwait-survey@example.com"
SENDGRID_API_KEY="SG...."
SURVEY_INVITE_DEFAULT_TO="cx-team@example.com"
SURVEY_COMPLETION_NOTIFY_TO="voc-notifications@example.com"

CRON_SECRET="generate-with-openssl-rand-base64-32"
SURVEY_INVITE_API_KEY="generate-with-openssl-rand-base64-32"
