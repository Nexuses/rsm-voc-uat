# RSM Voice of Client — environment variables

# Postgres (must have pgvector: CREATE EXTENSION IF NOT EXISTS vector;)
# Docker Postgres (recommended for local/VM): postgresql://rsm_voc:rsm_voc@localhost:5432/rsm_voc?schema=public
DATABASE_URL="postgresql://user:password@host:5432/rsm_voc?schema=public"

# OpenAI — insights, embeddings, Whisper fallback
OPENAI_API_KEY="sk-..."

# ElevenLabs post-call webhook signing secret (from the agent's webhook settings)
ELEVENLABS_WEBHOOK_SECRET="whsec_..."
# Optional override for configure script webhook lookup (defaults to NEXTAUTH_URL + /api/webhooks/elevenlabs)
# ELEVENLABS_WEBHOOK_URL="https://rsm-voc-survey.nexuses.xyz/api/webhooks/elevenlabs"


# ElevenLabs server API key — voice session signing and audio fallback
ELEVENLABS_API_KEY="..."
ELEVENLABS_AGENT_ID="agent_6401ktv5yqkmf2a95qpd3nh62380"


# NextAuth (CX dashboard auth)
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public survey URL used in invite email buttons (can differ from NEXTAUTH_URL)
SURVEY_PUBLIC_URL="https://rsm-voc-survey-new.vercel.app"

# SendGrid (dashboard invites, follow-ups, thank-you, and team notifications)
# FROM_EMAIL must be a verified SendGrid sender identity. Display name is RSM in Kuwait.
FROM_EMAIL="rsm-kuwait-survey@example.com"
SENDGRID_API_KEY="SG...."
# Optional default recipient prefilled on /dashboard/invite
SURVEY_INVITE_DEFAULT_TO="cx-team@example.com"
# Internal recipient(s) for survey completion notifications and scheduled CX reports (comma-separated)
SURVEY_COMPLETION_NOTIFY_TO="voc-notifications@example.com"
# Optional JSON name→email fallback used only when an invite names a partner
# or manager without an email and StaffContact has no email for that name.
SURVEY_STAFF_DIRECTORY='{"Partner Full Name":"partner@example.com"}'

# Secures GET /api/cron/survey-followups and GET /api/cron/scheduled-reports/{weekly|monthly|quarterly}
# (Vercel Cron sends Authorization: Bearer)
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Secures POST /api/integrations/survey-invites (server-to-server only)
SURVEY_INVITE_API_KEY="generate-with-openssl-rand-base64-32"

# Weekly DB backups to S3 (server only; see docs/DB_BACKUPS.md)
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="us-east-1"
# BACKUP_S3_BUCKET="rsm-voc-db-backups"
# BACKUP_APP_NAME="rsm_voc"
# BACKUP_DB_CONTAINER="rsm-voc-db"
# BACKUP_DB_NAME="rsm_voc"
# BACKUP_DB_USER="rsm_voc"
# BACKUP_NOTIFY_URL="https://hc-ping.com/..."

# CRM status webhooks (VOC → RSM Power Automate / CRM)
# CRM_STATUS_WEBHOOK_URL="https://prod-xx.westus.logic.azure.com/workflows/..."
# CRM_STATUS_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"
